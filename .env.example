# Copy this file to ".env" (same folder) and fill in what you have. ".env" is ignored by git: never commit it, never paste it in chat.
# --- AWS (only needed for the cloud brain, Polly voices, DynamoDB) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Copy the exact ID from the Bedrock console (Model catalog -> your Claude model -> "Model ID" or the inference profile ID)
BEDROCK_MODEL_ID=
# optional: semantic search
BEDROCK_EMBED_MODEL_ID=
# --- Voice for Hearth (free Nigerian English example) ---
LEGACYLINK_VOICE_EN=en-NG-EzinneNeural
