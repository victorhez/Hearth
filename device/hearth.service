[Unit]
Description=Hearth voice device
After=network-online.target sound.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/legacylink/device
Environment=HEARTH_SERVER=http://localhost:3333
Environment=HEARTH_HOUSEHOLD=home
Environment=HEARTH_TELLER=Grandma Rose
Environment=HEARTH_WAKEWORD=alexa
Environment=HEARTH_LED=neopixel
ExecStart=/home/pi/legacylink/device/.venv/bin/python hearth_device.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
